{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "IMGPIP",
  "description": "Use Picture-In-Picture on images",
  "version": "1.1.0",
  "default_locale": "en",
  "icons": {
    "16": "images/imgpip-icon-16.png",
    "32": "images/imgpip-icon-32.png",
    "48": "images/imgpip-icon-48.png",
    "128": "images/imgpip-icon-128.png"
  },
  "homepage_url": "https://bozdoz.com",
  "permissions": ["tabs", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "imgpip@bozdoz.com"
    }
  }
}
